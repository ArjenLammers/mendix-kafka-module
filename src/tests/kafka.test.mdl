/**
 * Kafka round-trip tests against the local SSL broker (dockert/compose.yaml).
 * Mirror Tests.TEST_Loopback and Tests.TEST_FileDocument, but assert with @expect
 * because UnitTesting asserts only throw inside a UnitTesting run.
 */

/**
 * @test String message sent synchronously is consumed with its header
 * @expect $Message != empty
 * @expect $Message/Payload = 'test'
 */
$UUID = call java action Tests.GenerateUUID();
$NewHeader = create Kafka.Header (Key = 'Reference', Value = $UUID);
$HeaderList = create list of Kafka.Header;
add $NewHeader to $HeaderList;
declare $ProducerName String = @Tests.ProducerString;
retrieve $Producer from Kafka.Producer
  where Name = $ProducerName
  first;
call java action Kafka.SendSynchronous(producer = $Producer, topic = @Tests.TopicString, key = empty, value = 'test', headers = $HeaderList, useCachedProducer = true);
call java action CommunityCommons.Delay(delaytime = 5000);
retrieve $Message from Tests.Message
  where Reference = $UUID
  first;
/

/**
 * @test Binary FileDocument sent synchronously is consumed with matching size
 * @expect $BinaryPayload != empty
 * @expect $BinaryPayload/Size = $Contents/Size
 */
$UUID = call java action Tests.GenerateUUID();
$NewHeader = create Kafka.Header (Key = 'Reference', Value = $UUID);
$HeaderList = create list of Kafka.Header;
add $NewHeader to $HeaderList;
declare $ProducerName String = @Tests.ProducerBinary;
retrieve $Producer from Kafka.Producer
  where Name = $ProducerName
  first;
$Contents = create System.FileDocument;
call java action CommunityCommons.GetFileContentsFromResource(filename = 'logo.png', fileDocument = $Contents);
call java action Kafka.SendSynchronous(producer = $Producer, topic = @Tests.TopicBinary, key = empty, value = empty, binaryValue = $Contents, headers = $HeaderList, useCachedProducer = true);
call java action CommunityCommons.Delay(delaytime = 5000);
retrieve $Message from Tests.Message
  where Reference = $UUID
  first;
retrieve $BinaryPayload from $Message/Tests.BinaryPayload_Message;
/

/**
 * Failure handling. Consumers read Continue/Retry when they start, so each test commits the setting
 * (@cleanup none: a rolled-back test transaction would hide it) and restarts the consumers, as saving
 * the consumer page does. The Retry test switches back to Continue at the end.
 * Failures and retries are only logged, so the assertions look at which messages were processed.
 */

/**
 * @test Continue on failure: the failed message is skipped and the next message is processed
 * @cleanup none
 * @expect $FailedSkipped
 * @expect $After != empty
 */
declare $ConsumerName String = @Tests.ConsumerString;
retrieve $Consumer from Kafka.Consumer
  where Name = $ConsumerName
  first;
change $Consumer (OnFailure = Kafka.FailureHandling.SKIP) commit without events;
call java action CommunityCommons.EndTransaction();
call java action CommunityCommons.StartTransaction();
call microflow Kafka.Sub_Restart();
call java action CommunityCommons.Delay(delaytime = 10000);
declare $ProducerName String = @Tests.ProducerString;
retrieve $Producer from Kafka.Producer
  where Name = $ProducerName
  first;
$FailUUID = call java action Tests.GenerateUUID();
$FailHeader = create Kafka.Header (Key = 'Reference', Value = $FailUUID);
$FailHeaders = create list of Kafka.Header;
add $FailHeader to $FailHeaders;
call java action Kafka.SendSynchronous(producer = $Producer, topic = @Tests.TopicString, key = 'failure-handling', value = 'fail-on-purpose', headers = $FailHeaders, useCachedProducer = true);
$AfterUUID = call java action Tests.GenerateUUID();
$AfterHeader = create Kafka.Header (Key = 'Reference', Value = $AfterUUID);
$AfterHeaders = create list of Kafka.Header;
add $AfterHeader to $AfterHeaders;
call java action Kafka.SendSynchronous(producer = $Producer, topic = @Tests.TopicString, key = 'failure-handling', value = 'after-skip', headers = $AfterHeaders, useCachedProducer = true);
call java action CommunityCommons.Delay(delaytime = 5000);
retrieve $Failed from Tests.Message
  where Reference = $FailUUID
  first;
declare $FailedSkipped Boolean = $Failed = empty;
retrieve $After from Tests.Message
  where Reference = $AfterUUID
  first;
/

/**
 * @test Retry on failure: the message is retried until it succeeds and the next message waits behind it
 * @cleanup none
 * @expect $WaitedBehind
 * @expect $Retried != empty
 * @expect $AfterRetry != empty
 */
declare $ConsumerName String = @Tests.ConsumerString;
retrieve $Consumer from Kafka.Consumer
  where Name = $ConsumerName
  first;
change $Consumer (OnFailure = Kafka.FailureHandling.RETRY, RetryDelaySeconds = 1, MaxRetryDelaySeconds = 2) commit without events;
call java action CommunityCommons.EndTransaction();
call java action CommunityCommons.StartTransaction();
call microflow Kafka.Sub_Restart();
call java action CommunityCommons.Delay(delaytime = 10000);
declare $ProducerName String = @Tests.ProducerString;
retrieve $Producer from Kafka.Producer
  where Name = $ProducerName
  first;
$FailUUID = call java action Tests.GenerateUUID();
$FailHeader = create Kafka.Header (Key = 'Reference', Value = $FailUUID);
$FailHeaders = create list of Kafka.Header;
add $FailHeader to $FailHeaders;
call java action Kafka.SendSynchronous(producer = $Producer, topic = @Tests.TopicString, key = 'failure-handling', value = 'fail-until-released', headers = $FailHeaders, useCachedProducer = true);
$AfterUUID = call java action Tests.GenerateUUID();
$AfterHeader = create Kafka.Header (Key = 'Reference', Value = $AfterUUID);
$AfterHeaders = create list of Kafka.Header;
add $AfterHeader to $AfterHeaders;
call java action Kafka.SendSynchronous(producer = $Producer, topic = @Tests.TopicString, key = 'failure-handling', value = 'after-retry', headers = $AfterHeaders, useCachedProducer = true);
call java action CommunityCommons.Delay(delaytime = 6000);
retrieve $WhileRetrying from Tests.Message
  where Reference = $AfterUUID
  first;
declare $WaitedBehind Boolean = $WhileRetrying = empty;
$Release = create Tests.Message (Reference = 'release:' + $FailUUID) commit;
call java action CommunityCommons.EndTransaction();
call java action CommunityCommons.StartTransaction();
call java action CommunityCommons.Delay(delaytime = 5000);
retrieve $Retried from Tests.Message
  where Reference = $FailUUID
  first;
retrieve $AfterRetry from Tests.Message
  where Reference = $AfterUUID
  first;
change $Consumer (OnFailure = Kafka.FailureHandling.SKIP) commit without events;
call java action CommunityCommons.EndTransaction();
call java action CommunityCommons.StartTransaction();
call microflow Kafka.Sub_Restart();
/
